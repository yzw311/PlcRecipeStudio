<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PackageId>PlcRecipe</PackageId>
    <Version>0.3.0</Version>
    <Authors>yzw311</Authors>
    <Description>PLC recipe models, codecs, and PLC drivers in one package.</Description>
    <PackageTags>PLC;recipe;drivers;Modbus;S7;FINS;automation</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/yzw311/PlcRecipeStudio</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\PlcRecipe.Core\**\*.cs" Exclude="..\PlcRecipe.Core\bin\**;..\PlcRecipe.Core\obj\**" />
    <Compile Include="..\PlcRecipe.Drivers\**\*.cs" Exclude="..\PlcRecipe.Drivers\bin\**;..\PlcRecipe.Drivers\obj\**" />
    <None Include="..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\LICENSE" Pack="true" PackagePath="LICENSE" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="S7netplus" Version="0.20.0" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>
</Project>
