<Window x:Class="PlcRecipe.WpfApp.Services.CompareDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配方对比"
        Width="900" Height="600" MinWidth="700" MinHeight="420" MaxWidth="1600" MaxHeight="1000"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Content.Bg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="SummaryText" FontSize="13" Margin="0,0,0,10" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Text.Primary}"/>

        <Border Grid.Row="1" Style="{DynamicResource CardBorder}">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" AlternationCount="2"
                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                      Background="Transparent" BorderThickness="0" IsReadOnly="False"
                      Foreground="{DynamicResource Brush.Text.Primary}"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Brush.Divider}">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="写入" Binding="{Binding Row.Selected}" Width="55"/>
                    <DataGridTextColumn Header="变量名" Binding="{Binding VarName}" IsReadOnly="True" Width="150"/>
                    <DataGridTextColumn Header="PLC 地址" Binding="{Binding Address}" IsReadOnly="True" Width="120"/>
                    <DataGridTextColumn Header="PLC 当前值" Binding="{Binding PlcValue}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="配方值" Binding="{Binding RecipeValue}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="单位" Binding="{Binding Unit}" IsReadOnly="True" Width="60"/>
                    <DataGridTextColumn Header="结果" Binding="{Binding StateText}" IsReadOnly="True" Width="80"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Row.State}" Value="Different">
                                <Setter Property="Background" Value="{DynamicResource Brush.Danger.Light}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Row.State}" Value="ReadFailed">
                                <Setter Property="Background" Value="{DynamicResource Brush.Warning.Light}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="全选差异项" Width="100" Height="32" Margin="0,0,8,0" Click="SelectAll_Click"
                    Background="{DynamicResource Brush.Secondary.Bg}"
                    Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border}"/>
            <Button x:Name="WriteButton" Content="写入勾选项到 PLC" Width="140" Height="32" Margin="0,0,8,0" Click="Write_Click"
                    Background="{DynamicResource Brush.Success}" Foreground="White" BorderThickness="0"/>
            <Button Content="关闭" Width="90" Height="32" Click="Close_Click"
                    Background="{DynamicResource Brush.Secondary.Bg}"
                    Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border}"/>
        </StackPanel>
    </Grid>
</Window>
