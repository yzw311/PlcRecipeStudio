<Window x:Class="PlcRecipe.WpfApp.Services.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="420" MinWidth="340" MinHeight="150"
        Background="{DynamicResource Brush.Content.Bg}"
        WindowStyle="ToolWindow">
    <StackPanel Margin="20">
        <TextBlock x:Name="CaptionText" Margin="0,0,0,10"
                   FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"/>
        <TextBox x:Name="TextBox" Height="32" FontSize="14" VerticalContentAlignment="Center"
                 Background="{DynamicResource Brush.Card.Bg}" Foreground="{DynamicResource Brush.Text.Primary}"
                 BorderBrush="{DynamicResource Brush.Border}"/>
        <PasswordBox x:Name="PwdBox" Height="32" FontSize="14" VerticalContentAlignment="Center"
                     Visibility="Collapsed"
                     Background="{DynamicResource Brush.Card.Bg}" Foreground="{DynamicResource Brush.Text.Primary}"
                     BorderBrush="{DynamicResource Brush.Border}"/>
        <ComboBox x:Name="ChoiceBox" Height="32" FontSize="14" Visibility="Collapsed"
                  Background="{DynamicResource Brush.Card.Bg}" Foreground="{DynamicResource Brush.Text.Primary}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="确定" Width="88" Height="32" Margin="0,0,10,0" Click="Ok_Click" IsDefault="True"
                    Background="{DynamicResource Brush.Primary}" Foreground="White" BorderThickness="0"/>
            <Button Content="取消" Width="88" Height="32" Click="Cancel_Click" IsCancel="True"
                    Background="{DynamicResource Brush.Secondary.Bg}" Foreground="{DynamicResource Brush.Text.Primary}"
                    BorderBrush="{DynamicResource Brush.Border}"/>
        </StackPanel>
    </StackPanel>
</Window>
