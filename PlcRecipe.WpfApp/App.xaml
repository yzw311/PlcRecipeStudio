<Application x:Class="PlcRecipe.WpfApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PlcRecipe.WpfApp.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- [0] HC 皮肤（ThemeService 运行时替换） -->
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <!-- [1] HC 控件主题 -->
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
                <!-- [2] 自有品牌主题（亮/暗切换，ThemeService 按索引替换 [0] 和 [2]） -->
                <ResourceDictionary Source="pack://application:,,,/PlcRecipeStudio;component/Themes/Light.xaml"/>
                <!-- [3] 主题无关共享样式（画刷引用走 DynamicResource，不参与切换） -->
                <ResourceDictionary Source="pack://application:,,,/PlcRecipeStudio;component/Themes/Shared.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 全局转换器 -->
            <conv:ResourceKeyToBrushConverter x:Key="KeyToBrush"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
