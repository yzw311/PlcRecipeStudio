<Window x:Class="PlcRecipe.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PlcRecipe.WpfApp.ViewModels"
        xmlns:pages="clr-namespace:PlcRecipe.WpfApp.Views.Pages"
        Title="PLC 配方管理系统"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="640" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:WorkbenchViewModel}">
            <pages:WorkbenchPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemManageViewModel}">
            <pages:SystemManagePage/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ====== 侧边栏 ====== -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar.Bg}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="16,20,16,14">
                    <Image Source="/Assets/logo.png" Width="44" Height="44" HorizontalAlignment="Left"/>
                    <TextBlock Text="PLC Recipe Studio" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Sidebar.Text}" Margin="0,10,0,0"/>
                    <TextBlock Text="配方管理系统" FontSize="11" Opacity="0.7"
                               Foreground="{DynamicResource Brush.Sidebar.Text}"/>
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding CurrentNavItem, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{DynamicResource NavListBoxItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,10,0"
                                           Foreground="{DynamicResource Brush.Sidebar.Text}"/>
                                <TextBlock Text="{Binding Label}" FontSize="14"
                                           Foreground="{DynamicResource Brush.Sidebar.Text}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="16,0,16,16">
                    <TextBlock FontSize="12" Opacity="0.85"
                               Foreground="{DynamicResource Brush.Sidebar.Text}">
                        <Run Text="{Binding CurrentUserName, Mode=OneWay}"/>
                        <Run Text=" · "/>
                        <Run Text="{Binding CurrentUserRole, Mode=OneWay}"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{Binding ThemeToggleText}" Command="{Binding ToggleThemeCommand}"
                                Height="30" Padding="10,0" FontSize="12"
                                Background="{DynamicResource Brush.Sidebar.Hover}" Foreground="{DynamicResource Brush.Sidebar.Text}" BorderThickness="0"
                                Cursor="Hand" Margin="0,0,8,0"/>
                        <Button Content="注销" Command="{Binding LogoutCommand}"
                                Height="30" Padding="10,0" FontSize="12"
                                Background="{DynamicResource Brush.Danger}" Foreground="{DynamicResource Brush.Text.OnAccent}"
                                BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ====== 内容区 ====== -->
        <Border Grid.Column="1" Background="{DynamicResource Brush.Content.Bg}">
            <ContentControl Content="{Binding CurrentPage}" Margin="20"/>
        </Border>
    </Grid>
</Window>
