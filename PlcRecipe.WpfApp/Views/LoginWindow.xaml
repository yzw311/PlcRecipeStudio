<Window x:Class="PlcRecipe.WpfApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配方管理系统 — 登录"
        Width="420" Height="520" MinWidth="380" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        TextOptions.TextFormattingMode="Display">
    <Border CornerRadius="14" Background="{DynamicResource Brush.Card.Bg}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.25"/>
        </Border.Effect>
        <Grid Margin="36,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 关闭按钮（无边框窗体的唯一可见关闭入口，配合 App 的退出联动） -->
            <Button Grid.Row="0" Content="✕" Width="28" Height="28" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="0,-20,-20,0"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Foreground="{DynamicResource Brush.Text.Secondary}"
                    Click="OnCloseClick" AutomationProperties.Name="关闭"/>

            <!-- Logo -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,18">
                <Image Source="/Assets/logo.png" Width="84" Height="84" Stretch="Uniform"/>
                <TextBlock Text="PLC Recipe Studio" FontSize="20" FontWeight="Bold" Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text.Primary}"/>
                <TextBlock Text="多 PLC 配方上传下载管理系统" FontSize="12" Margin="0,4,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text.Secondary}"/>
            </StackPanel>

            <!-- 用户名 -->
            <TextBox Grid.Row="1" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                     Height="40" FontSize="14" Margin="0,6"
                     VerticalContentAlignment="Center"
                     Background="{DynamicResource Brush.Content.Bg}"
                     Foreground="{DynamicResource Brush.Text.Primary}"
                     BorderBrush="{DynamicResource Brush.Border}"/>

            <!-- 密码 -->
            <PasswordBox Grid.Row="2" x:Name="PwdBox" Height="40" FontSize="14" Margin="0,6"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource Brush.Content.Bg}"
                         BorderBrush="{DynamicResource Brush.Border}"/>

            <!-- 错误 -->
            <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,6" MinHeight="18"/>

            <!-- 登录按钮 -->
            <Button Grid.Row="4" Content="登 录"
                    Height="42" FontSize="15" FontWeight="Bold" Margin="0,10,0,0"
                    Command="{Binding LoginCommand}" IsDefault="True"
                    Background="{DynamicResource Brush.Primary}" Foreground="White" BorderThickness="0"
                    Cursor="Hand"/>

            <TextBlock Grid.Row="6" Text="首次安装请先设置 PLCRECIPE_INITIAL_ADMIN_PASSWORD 环境变量"
                       FontSize="11" HorizontalAlignment="Center"
                       Foreground="{DynamicResource Brush.Text.Secondary}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowCredentialHint}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Border>
</Window>
