<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 亮色主题（按 UI 设计稿配色，仅画刷；共享样式见 Themes/Shared.xaml）============ -->

    <!-- 基础色 -->
    <SolidColorBrush x:Key="Brush.Content.Bg" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="Brush.Card.Bg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Secondary.Bg" Color="#EDF1F7"/>
    <SolidColorBrush x:Key="Brush.Sidebar.Bg" Color="#1E3A6E"/>
    <SolidColorBrush x:Key="Brush.Sidebar.Hover" Color="#2A4B8D"/>
    <SolidColorBrush x:Key="Brush.Sidebar.Active" Color="#16305E"/>
    <SolidColorBrush x:Key="Brush.Sidebar.Text" Color="#FFFFFF"/>

    <!-- 文本 -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#1F2937"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#6B7280"/>

    <!-- 边框 -->
    <SolidColorBrush x:Key="Brush.Border" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="#EDF0F5"/>

    <!-- 语义状态色 -->
    <SolidColorBrush x:Key="Brush.Success" Color="#16A34A"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#DC2626"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#D97706"/>
    <SolidColorBrush x:Key="Brush.Offline" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="Brush.Success.Light" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="Brush.Danger.Light" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="Brush.Warning.Light" Color="#FEF3C7"/>

    <!-- 主色 -->
    <SolidColorBrush x:Key="Brush.Primary" Color="#2563EB"/>
    <SolidColorBrush x:Key="Brush.Primary.Light" Color="#DBEAFE"/>

    <!-- 选中态 -->
    <SolidColorBrush x:Key="Brush.Selection" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="#94A3B8"/>
    <SolidColorBrush x:Key="Brush.Surface.Subtle" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Brush.Focus" Color="#60A5FA"/>
    <SolidColorBrush x:Key="Brush.Primary.Hover" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="Brush.Primary.Pressed" Color="#1E40AF"/>
    <SolidColorBrush x:Key="Brush.Disabled.Bg" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="Brush.Disabled.Text" Color="#9CA3AF"/>

    <!-- HandyControl 关键画刷对齐 -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="DarkPrimaryBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="SecondaryRegionBrush" Color="#EDF1F7"/>
    <SolidColorBrush x:Key="ThirdlyRegionBrush" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="RegionBrush" Color="#FFFFFF"/>

</ResourceDictionary>
